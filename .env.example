# FOYC (Figure Out Your Career) — Environment Configuration Template
# Copy this file to .env and provide your specific credentials.

# -------------------------------------------------------------
# Frontend Configuration (Vite)
# -------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://rlrzdvebvbtegxixyfrb.supabase.co

# Supabase Public Anonymous Key (safe for client-side usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend API Base URL (defaults to http://localhost:5000 in local dev)
VITE_API_URL=http://localhost:5000

# -------------------------------------------------------------
# Backend Configuration (Node / Express)
# -------------------------------------------------------------
PORT=5000
NODE_ENV=development
SUPABASE_URL=https://rlrzdvebvbtegxixyfrb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
CORS_ORIGIN=http://localhost:5173
