{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foyc.app/schemas/foyc_handoff_v1.json",
  "title": "FOYC Dashboard Handoff Schema v1",
  "description": "Standardized data contract for importing structured career discovery blueprints generated by ChatGPT into the FOYC living dashboard.",
  "type": "object",
  "required": [
    "schemaVersion",
    "careerDirection",
    "milestones",
    "tasks",
    "habits"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["foyc_handoff_v1"],
      "default": "foyc_handoff_v1"
    },
    "profile": {
      "type": "object",
      "properties": {
        "preferredName": { "type": "string" },
        "country": { "type": "string" },
        "educationOrProfession": { "type": "string" },
        "careerStage": { "type": "string" },
        "workExperience": { "type": "string" },
        "availableHoursPerWeek": { "type": "integer", "minimum": 1, "maximum": 80 }
      }
    },
    "careerDirection": {
      "type": "object",
      "required": ["primaryTitle", "summary", "whyRecommended"],
      "properties": {
        "primaryTitle": { "type": "string" },
        "summary": { "type": "string" },
        "whyRecommended": { "type": "string" },
        "longTermGoal": { "type": "string" },
        "shortTermObjective": { "type": "string" },
        "alternativeTitles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidenceLevel": {
          "type": "string",
          "enum": ["high", "medium", "exploratory"]
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "strengths": {
      "type": "object",
      "properties": {
        "coreStrengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transferableSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keyInterests": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "skillGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skillName", "priority"],
        "properties": {
          "skillName": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "currentProficiency": { "type": "string" },
          "targetProficiency": { "type": "string" },
          "sequenceOrder": { "type": "integer" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "stage", "priority", "estimatedDuration"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "stage": {
            "type": "string",
            "enum": [
              "Foundation",
              "Skill Development",
              "Practical Application",
              "Professional Readiness",
              "Career Growth"
            ]
          },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "estimatedDuration": { "type": "string" },
          "targetDate": { "type": "string" },
          "completionCriteria": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "category", "priority"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["Foundation", "Technical", "Portfolio", "Networking", "Job Prep"]
          },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "dueDate": { "type": "string" },
          "relatedMilestone": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "habits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "frequency", "targetDaysPerWeek"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "frequency": { "type": "string", "enum": ["daily", "weekly", "custom"] },
          "targetDaysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
          "category": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "skillsDeveloped": {
            "type": "array",
            "items": { "type": "string" }
          },
          "targetDate": { "type": "string" },
          "deliverables": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "type", "url"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["Documentation", "Course", "Book", "Video", "Practice", "Certification"]
          },
          "provider": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "isVerified": { "type": "boolean" },
          "isFree": { "type": "boolean" }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "suggestedFrequency": { "type": "string", "default": "weekly" },
        "reassessmentQuestions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
