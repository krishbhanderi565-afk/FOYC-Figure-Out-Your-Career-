{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FOYCDashboardHandoffV2",
  "description": "Canonical schema for ChatGPT handoff data importing into the FOYC Personalized Career Dashboard.",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "career_direction",
    "roadmap",
    "tasks",
    "habits"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["foyc_dashboard_v2", "foyc_handoff_v1"],
      "default": "foyc_dashboard_v2"
    },
    "profile": {
      "type": "object",
      "required": ["preferred_name"],
      "properties": {
        "preferred_name": { "type": "string" },
        "country": { "type": ["string", "null"] },
        "current_education_or_profession": { "type": ["string", "null"] },
        "current_career_stage": { "type": ["string", "null"] },
        "work_experience": { "type": ["string", "null"] },
        "current_field": { "type": ["string", "null"] }
      }
    },
    "career_direction": {
      "type": "object",
      "required": ["primary_career_direction", "career_description", "why_this_direction_was_suggested"],
      "properties": {
        "primary_career_direction": { "type": "string" },
        "career_description": { "type": "string" },
        "why_this_direction_was_suggested": { "type": "string" },
        "key_responsibilities": { "type": "array", "items": { "type": "string" } },
        "expected_opportunities": { "type": "array", "items": { "type": "string" } },
        "alternative_career_paths": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "overlap_score": { "type": "number" }
                }
              }
            ]
          }
        },
        "important_trade_offs": { "type": "array", "items": { "type": "string" } },
        "confidence_level": { "type": ["string", "number"] }
      }
    },
    "strengths_and_skills": {
      "type": "object",
      "properties": {
        "existing_strengths": { "type": "array", "items": { "type": "string" } },
        "transferable_skills": { "type": "array", "items": { "type": "string" } },
        "current_technical_skills": { "type": "array", "items": { "type": "string" } },
        "current_professional_skills": { "type": "array", "items": { "type": "string" } },
        "skills_to_improve": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skill_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_name", "priority"],
        "properties": {
          "skill_name": { "type": "string" },
          "current_level": { "type": ["string", "null"] },
          "target_level": { "type": ["string", "null"] },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "explanation": { "type": "string" },
          "recommended_learning_order": { "type": "number" }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "required": ["long_term_goal", "milestones"],
      "properties": {
        "long_term_goal": { "type": "string" },
        "short_term_goals": { "type": "array", "items": { "type": "string" } },
        "career_stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage_name": { "type": "string" },
              "target_duration": { "type": "string" },
              "completion_criteria": { "type": "string" }
            }
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "stage"],
            "properties": {
              "id": { "type": "string" },
              "stage": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "priority": { "type": "string" },
              "target_duration": { "type": "string" },
              "completion_criteria": { "type": "string" },
              "dependencies": { "type": "array", "items": { "type": "string" } },
              "is_completed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "category"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "estimated_duration": { "type": "string" },
          "due_date": { "type": ["string", "null"] },
          "related_milestone": { "type": ["string", "null"] },
          "is_completed": { "type": "boolean" }
        }
      }
    },
    "habits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "target"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "frequency": { "type": "string", "enum": ["daily", "weekly"] },
          "target": { "type": "string" },
          "category": { "type": "string" },
          "streak": { "type": "number" },
          "completed_today": { "type": "boolean" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "skills_developed": { "type": "array", "items": { "type": "string" } },
          "expected_output": { "type": "string" },
          "milestones": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["planned", "in_progress", "completed"] },
          "github_url": { "type": ["string", "null"] },
          "live_demo_url": { "type": ["string", "null"] }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "resource_type"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "resource_type": { "type": "string", "enum": ["Documentation", "Course", "Book", "Practice", "Video"] },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "related_skill": { "type": "string" },
          "is_verified": { "type": "boolean" }
        }
      }
    },
    "review_schedule": {
      "type": "object",
      "properties": {
        "frequency": { "type": "string" },
        "weekly_goals": { "type": "array", "items": { "type": "string" } },
        "reflection_questions": { "type": "array", "items": { "type": "string" } },
        "progress_indicators": { "type": "array", "items": { "type": "string" } },
        "suggested_reassessment_date": { "type": ["string", "null"] }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence_and_uncertainties": {
      "type": ["string", "object", "null"]
    }
  }
}
